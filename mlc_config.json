{
  "ignorePatterns": [
  ],
  "replacementPatterns": [
    {
      "pattern": "^/ja/(.*?)/?$",
      "replacement": "file:///github/workspace/content/$1.ja.md"
    },
    {
      "pattern": "^/(?!ja/)(.*?)/?$",
      "replacement": "file:///github/workspace/content/$1.en.md"
    }
  ],
  "httpHeaders": [
  ],
  "timeout": "20s",
  "retryOn429": true,
  "retryCount": 5,
  "fallbackRetryDelay": "30s",
  "aliveStatusCodes": [200, 206]
}
