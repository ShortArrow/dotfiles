# Generated files by hugo
/public/
/resources/_gen/
/assets/jsconfig.json
hugo_stats.json

# Executable may be added to repository
hugo.exe
hugo.darwin
hugo.linux

# Temporary lock file while building
/.hugo_build.lock

# neovim startup log
startup.log

# AI

.claude/settings.local.json

# pathlint dogfood snapshots are kept local-only (too large + host-PII-ish)
pathlint/snapshots/

# Working directory
/work

# Local agent endpoints (LAN IP)
/agents.config.json

# PATH snapshots with raw user paths
windows/*.bk.txt


# GlazeWM's machine-specific ignore list. GlazeWM reads one file with no
# include directive, so Merge-GlazewmConfig.ps1 splices this into the tracked
# config at apply time. Keeping it out means the published config does not
# enumerate the applications on any one machine.
glazewm/ignore-local.txt
