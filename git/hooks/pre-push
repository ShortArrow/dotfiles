#!/usr/bin/env bash
# Refuse to push commits whose messages carry attribution.
#
# commit-msg only guards commits made on this machine after the hook was
# installed. Everything else arrives already written — pulled from another
# machine, made before the hook existed, or rebased in from a branch — and
# this is where those are caught, at the last point before they become
# public.
#
# A repository's own pre-push is called at the end with the same arguments
# and the same stdin, which is buffered here rather than consumed.
set -u

hook_dir=$(cd -P "$(dirname "$0")" && pwd)
# shellcheck source=attribution.sh
. "$hook_dir/attribution.sh"

zero=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')
refs=$(cat)
found=0

while read -r _local_ref local_oid _remote_ref remote_oid; do
  [ -n "${local_oid:-}" ] || continue
  # A deletion pushes nothing, so there is nothing to read.
  [ "$local_oid" = "$zero" ] && continue

  if [ "$remote_oid" = "$zero" ]; then
    # A new branch: everything already on some remote is not ours to judge.
    range=$(git rev-list "$local_oid" --not --remotes)
  else
    range=$(git rev-list "$remote_oid..$local_oid")
  fi

  for commit in $range; do
    if git log -1 --format=%B "$commit" | has_attribution; then
      if [ "$found" -eq 0 ]; then
        printf '%s\n' "pre-push: attribution in commits about to be pushed" >&2
        found=1
      fi
      printf '    %s %s\n' "$(git rev-parse --short "$commit")" "$(git log -1 --format=%s "$commit")" >&2
    fi
  done
done <<EOF
$refs
EOF

if [ "$found" -ne 0 ]; then
  printf '%s\n' "Rewrite the messages before pushing — git rebase --exec, or filter-branch" >&2
  printf '%s\n' "over the range — then push again." >&2
  exit 1
fi

own_hook="$(git rev-parse --git-dir)/hooks/pre-push"
if [ -x "$own_hook" ]; then
  printf '%s\n' "$refs" | exec "$own_hook" "$@"
fi
