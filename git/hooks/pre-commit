#!/usr/bin/env bash
# Say why signing is refused before git's own fatal does it cryptically.
#
# On this machine commits are signed with GPG, and the key is declared per
# repository — deliberately, like user.email — because more than one
# identity lives in the keyring. To anyone who has not read that decision,
# the resulting "fatal: user.signingkey ... needs to be configured" reads
# as a broken setup, and helpful hands (human or coding agent) "repair" it
# with a global key. Explain the state where the confusion starts.
#
# A repository's own pre-commit is called at the end.
set -u

if [ "$(git config --get commit.gpgsign)" = "true" ] &&
   [ -z "$(git config --get user.signingkey)" ]; then
  cat >&2 <<'MSG'
pre-commit: no signing identity declared for this repository.

This is the designed state, not damage: on this machine the signing key
is declared per repository, because the keyring holds more than one
identity. Do NOT "repair" this with a global user.signingkey. Declare
the identity for this repository:

    Set-GitSigningKey       (pwsh: fzf over the keyring's secret keys)
    gsk                     (runex abbreviation of the same one-liner)
    git config user.signingkey <key id from gpg --list-secret-keys>
MSG
  exit 1
fi

own_hook="$(git rev-parse --git-dir)/hooks/pre-commit"
if [ -x "$own_hook" ]; then
  exec "$own_hook" "$@"
fi
