{
  "env": {
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "1"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "includeCoAuthoredBy": false,
  "skillListingBudgetFraction": 0.03,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash ~/.claude/check-attribution.sh",
            "statusMessage": "Checking for attribution"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/check-machine-guards.sh",
            "shell": "bash",
            "statusMessage": "Checking machine guards"
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "bash ~/.claude/check-gpg-cache.sh",
            "statusMessage": "Checking the signing key is unlocked"
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "perl ~/.claude/check-gpg-clearsign.pl",
            "statusMessage": "Checking for a gpg --clearsign the user should run as git unlock"
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "bash ~/.claude/check-remote-schtasks.sh",
            "statusMessage": "Checking for task registration over ssh"
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "bash ~/.claude/judge-command.sh",
            "timeout": 3,
            "statusMessage": "Asking the decision model"
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash ~/.claude/check-attribution.sh",
            "statusMessage": "Checking for attribution"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/check-machine-guards.sh",
            "shell": "bash",
            "statusMessage": "Checking machine guards"
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "bash ~/.claude/check-gpg-cache.sh",
            "statusMessage": "Checking the signing key is unlocked"
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "perl ~/.claude/check-gpg-clearsign.pl",
            "statusMessage": "Checking for a gpg --clearsign the user should run as git unlock"
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "bash ~/.claude/check-remote-schtasks.sh",
            "statusMessage": "Checking for task registration over ssh"
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "bash ~/.claude/judge-command.sh",
            "timeout": 3,
            "statusMessage": "Asking the decision model"
          }
        ]
      }
    ]
  }
}
